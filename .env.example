# Token del bot de Discord (Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=

# Prefijo para los comandos de texto (los comandos slash /siempre funcionan además de este)
COMMAND_PREFIX=!

# Volumen inicial de reproducción (0-100)
DEFAULT_VOLUME=50

# Segundos de inactividad (cola vacía, nada sonando) antes de que el bot se desconecte solo
INACTIVITY_TIMEOUT_SECONDS=300

# ID de un servidor de prueba para sincronizar los slash commands al instante con !sync.
# Dejalo vacío para sincronizar de forma global (puede tardar hasta 1 hora en propagarse).
DEV_GUILD_ID=

# Ruta al ejecutable de ffmpeg. Dejalo vacío si ffmpeg ya está en el PATH del sistema.
FFMPEG_PATH=
